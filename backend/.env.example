# HandoffGuard Backend Configuration
# Copy this file to .env and fill in the values

# Application
APP_ENV=development
APP_NAME=HandoffGuard
APP_VERSION=1.0.0
DEBUG=true

# ============================================================
# OPTION A — Exasol Personal (recommended for ExaThon demo)
# ============================================================
DATABASE_ENGINE=exasol
EXASOL_HOST=localhost
EXASOL_PORT=8563
EXASOL_USER=sys
EXASOL_PASSWORD=exasol
EXASOL_SCHEMA=HANDOFFGUARD
EXASOL_ENCRYPTION=false

# ============================================================
# OPTION B — SQLite (local fallback, no Exasol required)
# ============================================================
# DATABASE_ENGINE=sqlite
# SQLITE_URL=sqlite+aiosqlite:///./handoffguard_dev.db

# ============================================================
# OPTION C — PostgreSQL
# ============================================================
# DATABASE_ENGINE=postgres
# POSTGRES_URL=postgresql+asyncpg://user:password@localhost:5432/handoffguard

# Domain Config
SKEW_TOLERANCE_SECONDS=120
MAX_CHART_POINTS_PER_LOGGER=500
SCHEMA_VERSION=1.0.0
