# HandoffGuard Backend Configuration
# Copy this file to .env and adjust as necessary for your environment.

# Application Environment
APP_ENV=development
APP_NAME=HandoffGuard
APP_VERSION=1.0.0
DEBUG=true

# Database Engine Selection: 'exasol' or 'sqlite'
DATABASE_ENGINE=exasol

# Exasol Personal (Docker on localhost:8563)
EXASOL_HOST=localhost
EXASOL_PORT=8563
EXASOL_USER=sys
EXASOL_PASSWORD=exasol
EXASOL_SCHEMA=HANDOFFGUARD
EXASOL_ENCRYPTION=false

# Domain & Modeling Parameters
# Configurable prototype default: 600s (10 min) maximum supported gap between readings.
# Note: Engineering/demo prototype assumption, not a validated pharmaceutical standard.
MAX_GAP_SECONDS=600
SKEW_TOLERANCE_SECONDS=120
MAX_CHART_POINTS_PER_LOGGER=500
