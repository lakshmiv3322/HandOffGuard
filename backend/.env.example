# HandoffGuard Backend Configuration
# Copy this file to .env and fill in the values

# Application
APP_ENV=development
APP_NAME=HandoffGuard
APP_VERSION=1.0.0
DEBUG=true

# Database Engine: "sqlite" | "postgres" | "exasol"
DATABASE_ENGINE=sqlite

# SQLite (used when DATABASE_ENGINE=sqlite)
SQLITE_URL=sqlite+aiosqlite:///./handoffguard_dev.db

# PostgreSQL (used when DATABASE_ENGINE=postgres)
# POSTGRES_URL=postgresql+asyncpg://user:password@localhost:5432/handoffguard

# Exasol (used when DATABASE_ENGINE=exasol)
# EXASOL_HOST=exasol-host.example.com
# EXASOL_PORT=8563
# EXASOL_USER=sys
# EXASOL_PASSWORD=secret
# EXASOL_SCHEMA=HANDOFFGUARD

# Domain Config
SKEW_TOLERANCE_SECONDS=120
MAX_CHART_POINTS_PER_LOGGER=500
SCHEMA_VERSION=1.0.0
